# --- Telegram (wajib untuk bot; kosongkan = bot mati, API tetap jalan) ---
TELEGRAM_BOT_TOKEN=
# Whitelist chat_id (wajib diisi, pisahkan koma). Ambil id via @userinfobot.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Google Sheets / Cash Report (kosongkan = tulis gagal, hasil diantre ke pending.jsonl) ---
# Folder Cash Report sudah di-share ke service account sebagai Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# Untuk hosting (Render dll): isi dengan isi file service_account.json (JSON mentah),
# menggantikan GOOGLE_SERVICE_ACCOUNT_FILE.
GOOGLE_SERVICE_ACCOUNT_JSON=
CASH_REPORT_FOLDER_ID=
CASH_REPORT_TEMPLATE_ID=
# Tahun pada nama tab/header template (default 2025) & bank fallback bila
# ekstraksi tidak membaca bank (default TUNAI).
CASH_REPORT_TEMPLATE_YEAR=2025
CR_DEFAULT_BANK=TUNAI

# --- Google Drive (opsional: arsip bukti transfer + kolom Lampiran) ---
# OAuth akun user (service account tidak bisa — Google memblokir SA membuat file).
# Scope penuh "drive" — lihat README "Setup Google Drive": buat OAuth client
# (Desktop), ambil refresh token dengan scope https://www.googleapis.com/auth/drive.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# ID folder Receipts di Drive (milik akun OAuth; tidak perlu share — file milik user OAuth).
GOOGLE_DRIVE_FOLDER_ID=

# --- Hosting (Render dll) ---
# HOST=0.0.0.0 agar bisa diakses hosting; default 127.0.0.1 (lokal)
HOST=

# --- AI vision ekstraksi (kosongkan = mode mock dari nama file) ---
# Mendukung endpoint kompatibel OpenAI (chat/completions).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Server ---
PORT=8000
