# --- Telegram (wajib untuk bot; kosongkan = bot mati, API tetap jalan) ---
TELEGRAM_BOT_TOKEN=
# Whitelist chat_id (wajib diisi, pisahkan koma). Ambil id via @userinfobot.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Google Sheets / Cash Report (kosongkan = tulis gagal, hasil diantre ke pending.jsonl) ---
# Folder Cash Report sudah di-share ke service account sebagai Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# Untuk hosting (Render dll): isi dengan isi file service_account.json (JSON mentah),
# menggantikan GOOGLE_SERVICE_ACCOUNT_FILE.
GOOGLE_SERVICE_ACCOUNT_JSON=
CASH_REPORT_FOLDER_ID=
# Id spreadsheet template dari `python cash_report/build_template.py`
CASH_REPORT_TEMPLATE_ID=
# Kantong fallback bila ekstraksi tidak membacanya
# (nilai valid: BRI, BNI, Jago, UANG KAS — lihat sheet SETUP template)
CR_DEFAULT_BANK=UANG KAS

# --- Google Drive (arsip bukti transfer + kolom Link Bukti) ---
# Service account tidak bisa membuat file (kuota 0) dan OAuth Testing kedaluwarsa
# tiap7 hari — operasi pembuat file lewat Apps Script Web App (apps_script/Code.gs,
# README bagian Drive). APPS_SCRIPT_URL = URL /exec hasil Deploy (Execute as: Me,
# Who has access: Anyone); APPS_SCRIPT_SECRET = nilai SECRET di Script Properties.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
# ID folder Receipts di Drive (milik akun pemilik Apps Script).
GOOGLE_DRIVE_FOLDER_ID=

# --- Hosting (Render dll) ---
# HOST=0.0.0.0 agar bisa diakses hosting; default 127.0.0.1 (lokal)
HOST=

# --- AI vision ekstraksi (kosongkan = mode mock dari nama file) ---
# Mendukung endpoint kompatibel OpenAI (chat/completions).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Rekonsiliasi mutasi bank (opsional) ---
# Nomor rekening tiap kantong, dicocokkan dengan no rek hasil ekstraksi PDF
# mutasi. Kosongkan = kirim PDF mutasi ditolak (no rek tak cocok mapping).
BNI_ACCOUNT_NUMBER=
BRI_ACCOUNT_NUMBER=
JAGO_ACCOUNT_NUMBER=

# --- Server ---
PORT=8000
# Level log: DEBUG | INFO | WARNING | ERROR (default INFO)
LOG_LEVEL=INFO

# --- Observability (Sentry) ---
# Kosongkan SENTRY_DSN = Sentry mati, bot tetap jalan normal di lokal.
# DSN bukan token: hanya dipakai untuk MENGIRIM error/log/trace, bukan membaca API.
SENTRY_DSN=
# Pisahkan data lokal dan produksi di dashboard Sentry.
# Wajib diisi: development untuk lokal, production untuk server.
# Kalau dikosongkan, event dianggap production (default Sentry).
SENTRY_ENVIRONMENT=development
# Persentase request yang direkam untuk tracing (0 = mati, 1 = semua).
SENTRY_TRACES_SAMPLE_RATE=0.1
# Opsional: tandai error berasal dari versi kode mana (mis. git commit pendek).
SENTRY_RELEASE=

# --- Evaluasi kriteria (opsional; hanya untuk menjalankan suite SC) ---
# Dua nilai di bawah punya bawaan yang cocok dengan hasil `--download`.
# Kosongkan saja kecuali ingin menaruh data di tempat lain.
SC_PAIRS=dataset/pairs.csv
SC_IMAGES=dataset/Bukti Transaksi Januari 2026
# Opsional. Repo dataset publik, jadi `--download` bekerja tanpa token.
# Isi hanya bila repo dataset suatu saat dijadikan privat lagi.
GITHUB_TOKEN=
# Repo dataset kelompok. Ubah hanya bila datanya dipindahkan ke tempat lain.
GITHUB_DATASET_REPO=Project-Rework-G3-AI/rework-ai-finance-assistant-dataset
# Folder dataset di dalam repo tersebut. Kosongkan bila berkas ada di akar repo.
GITHUB_DATASET_DIR=

# --- SC-03: waktu proses sampai tersimpan ---
# Pengukuran menulis baris SUNGGUHAN ke Google Sheets, karena itu wajib memakai
# folder sandbox, bukan folder Cash Report perusahaan. Tidak ada nilai bawaan:
# tanpa dua id ini, harness menolak berjalan.
# Buat dengan: python3 tests/_sandbox_build.py
SC03_SANDBOX_FOLDER=
SC03_SANDBOX_TEMPLATE=
# Lokasi modul kredensial Google (google_api.py). Kosongkan bila sudah di path.
GOOGLE_SCRIPTS_DIR=

# --- SC-04: biaya per gambar ---
# Tarif model dan kurs punya nilai bawaan di tests/sc04_cost.py. Isi di sini
# hanya bila ingin menimpa tanpa menyunting kode.
# USD per token:
SC04_PRICE_PROMPT_USD=
SC04_PRICE_COMPLETION_USD=
# Rupiah per USD. Wajib diisi bila USD_TO_IDR di kode masih 0.
SC04_USD_IDR=
# Target rupiah per gambar (bawaan 50, dari BRD).
SC04_TARGET_IDR=

# --- Pelacakan LLM (Langfuse Cloud, opsional) ---
# Kosongkan keduanya = Langfuse mati, bot tetap jalan. Yang dikirim hanya teks
# (prompt + output JSON + token) — gambar/kredensial tidak pernah dikirim.
# Key dari cloud.langfuse.com -> Settings -> API Keys.
# SDK v5 wajib (endpoint ingestion v4); LANGFUSE_BASE_URL hanya perlu diisi
# bila region bukan EU default.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # US: us.cloud.langfuse.com, JP: jp.cloud.langfuse.com
